(ns phel-wp-plugin.collab
  (:require phel.html :refer [html])
  (:require phel-wp-plugin.datastar :as datastar))

(def state-option "phel_collab_demo_state")
(def nonce-action "phel_collab_demo")

(defn default-state []
  #php {"revision" 0
        "message" "Open this dashboard as two users and edit this shared note."
        "updated_by" "Nobody yet"
        "updated_at" ""})

;; A deliberately small "global cursor": unlike Hyper's in-process cursor this
;; value is reconstructed from persistent WordPress state on every PHP request.
(defn global-cursor-read []
  (let [state (php/get_option state-option nil)]
    (if (php/is_array state)
      state
      (default-state))))

(defn state-value [state key fallback]
  (let [value (php/aget state key)]
    (if (nil? value) fallback value)))

(defn state-revision [state]
  (php/intval (state-value state "revision" 0)))

(defn state-message [state]
  (str (state-value state "message" "")))

(defn current-user-name []
  (.-user_login (php/wp_get_current_user)))

(defn next-state [state message]
  #php {"revision" (+ 1 (state-revision state))
        "message" message
        "updated_by" (current-user-name)
        "updated_at" (php/current_time "mysql")})

(defn global-cursor-write! [state]
  (php/update_option state-option state)
  state)

(defn reactive-region [state]
  [:div {:id "phel-collab-region"
         :data-revision (state-revision state)}
   [:p
    [:strong "Shared note (revision " (state-revision state) ")"]]
   [:blockquote (state-message state)]
   [:p {:class "description"}
    "Last changed by "
    (str (state-value state "updated_by" "Unknown"))
    (let [updated-at (state-value state "updated_at" "")]
      (if (= "" updated-at)
        "."
        (str " at " updated-at ".")))]] )

(defn render-reactive-region [state]
  (html (reactive-region state)))

(defn state-patches [state]
  [{:selector "#phel-collab-region"
    :mode "outer"
    :element (render-reactive-region state)}
   {:signals (php/wp_json_encode
              #php {"revision" (state-revision state)
                    "message" (state-message state)})}])

(defn plugin-main-file []
  (str (php/dirname (php/dirname *file*)) "/phel-wp-plugin.php"))

(defn datastar-action-url [action]
  (php/add_query_arg
   #php {"action" action
         "nonce" (php/wp_create_nonce nonce-action)}
   (php/admin_url "admin-ajax.php")))

(defn datastar-post-expression [action]
  (str "@post('" (datastar-action-url action)
       "', {contentType: 'form', requestCancellation: 'auto'})"))

(defn initial-signals [state]
  ;; The only browser state is the form currently being edited and its version.
  ;; WordPress remains authoritative for the shared note itself.
  (str "{revision: " (state-revision state)
       ", message: " (php/wp_json_encode (state-message state)) "}"))

(defn datastar-script-tag [tag handle source]
  ;; This WordPress version does not honor wp_script_add_data's `type` field.
  ;; Datastar is an ES module, so replace only its script tag at render time.
  (if (= "phel-datastar" handle)
    (str "<script type=\"module\" id=\"phel-datastar-js\" src=\""
         (php/esc_url source) "\"></script>\n")
    tag))

(defn enqueue-assets [hook-suffix]
  (when (= "index.php" hook-suffix)
    (php/wp_enqueue_script
     "phel-datastar"
     "https://cdn.jsdelivr.net/gh/starfederation/datastar@1.0.2/bundles/datastar.js"
     #php []
     "1.0.2"
     true)))

(defn collab-widget-content []
  (let [state (global-cursor-read)]
    (println
     (html
      [:form {:id "phel-collab-demo"
              :data-signals (initial-signals state)
              :data-on-interval__duration.5s (datastar-post-expression "phel_collab_heartbeat")}
       [:p
        "This prototype uses Datastar's five-second interval heartbeat. "
        "Each poll is a short request whose finite SSE response morphs the "
        "shared region from WordPress's authoritative state."]
       (reactive-region state)
       [:input {:type "hidden"
                :name "revision"
                :data-bind:revision ""}]
       [:hr]
       [:p [:strong "Tab-local edit"]]
       [:textarea {:id "phel-collab-message"
                   :name "message"
                   :rows 4
                   :style "width:100%;box-sizing:border-box;"
                   :data-bind:message ""}]
       [:p {:data-indicator:saving ""}
        [:button {:id "phel-collab-save"
                  :class "button button-primary"
                  :type "button"
                  :data-on:click (datastar-post-expression "phel_collab_mutate")}
         "Save shared note"]
        " "
        [:button {:id "phel-collab-refresh"
                  :class "button"
                  :type "button"
                  :data-on:click (datastar-post-expression "phel_collab_heartbeat")}
         "Poll now"]]
       [:p {:id "phel-collab-status"
            :class "description"
            :aria-live "polite"
            :data-indicator:saving ""}
        [:span {:data-show "$saving"} "Saving shared note..."]
        [:span {:data-show "!$saving"}
         "Waiting for changes from collaborators."]]]))))

(defn request-param [key fallback]
  (let [value (php/aget php/$_POST key)]
    (if (nil? value)
      fallback
      (php/wp_unslash value))))

(defn require-edit-posts! []
  (when-not (php/current_user_can "edit_posts")
    (php/wp_die "You are not allowed to edit this note." "Forbidden"
                #php {"response" 403})))

(defn ajax-heartbeat []
  (datastar/start!)
  (php/check_ajax_referer nonce-action "nonce")
  (require-edit-posts!)
  (let [state (global-cursor-read)
        known-revision (php/intval (request-param "revision" -1))]
    (if (= known-revision (state-revision state))
      (datastar/emit! [])
      (datastar/emit! (state-patches state)))))

(defn ajax-mutate []
  (datastar/start!)
  (php/check_ajax_referer nonce-action "nonce")
  (require-edit-posts!)
  (let [state (global-cursor-read)
        based-on-revision (php/intval (request-param "revision" -1))]
    (if (not (= based-on-revision (state-revision state)))
      ;; A stale editor is shown the source-of-truth region and receives the
      ;; current form signals instead of silently overwriting a collaborator.
      (datastar/emit! (state-patches state))
      (let [message (php/sanitize_textarea_field
                     (str (request-param "message" "")))
            new-state (global-cursor-write! (next-state state message))]
        (datastar/emit! (state-patches new-state))))))

(defn register! []
  (php/add_action "admin_enqueue_scripts" enqueue-assets 10 1)
  (php/add_filter "script_loader_tag" datastar-script-tag 10 3)
  (php/add_action "wp_ajax_phel_collab_heartbeat" ajax-heartbeat)
  (php/add_action "wp_ajax_phel_collab_mutate" ajax-mutate)
  (php/add_action
   "wp_dashboard_setup"
   #(php/wp_add_dashboard_widget
     "phel-collab-demo-widget"
     "Phel collaborative Datastar prototype"
     collab-widget-content)))
